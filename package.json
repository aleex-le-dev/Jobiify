{
  "name": "jobiify",
  "version": "1.37.0",
  "description": "Jobiify — recherche d’emploi locale dans le Pas-de-Calais (62) : offres et missions d’intérim triées par profil et par temps de trajet.",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "keywords": [
    "emploi",
    "recherche-emploi",
    "interim",
    "pas-de-calais",
    "france-travail"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aleex-le-dev/career-ops"
  },
  "license": "MIT",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "test": "npm --prefix web test",
    "typecheck": "npm --prefix web run typecheck",
    "doctor": "node scripts/doctor.mjs",
    "scan": "node scripts/scan.mjs",
    "verify": "node scripts/verify-pipeline.mjs",
    "verify:portals": "node scripts/verify-portals.mjs",
    "merge": "node scripts/merge-tracker.mjs",
    "postinstall": "node -e \"process.exit(['','0','false'].includes((process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD||'').toLowerCase())?1:0)\" || npx playwright install chromium || npx playwright install chromium"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "js-yaml": "^5.3.0",
    "playwright": "1.64.0",
    "undici": "^6.28.1"
  }
}
